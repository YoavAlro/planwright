{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/YoavAlro/planwright/main/schema/plan.schema.json",
  "title": "Planwright feature plan",
  "description": "Cached, replayable action lists for the scenarios of one .feature file. Generated by planwright; review diffs, do not hand-edit casually.",
  "type": "object",
  "required": ["version", "feature", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "feature": { "type": "string", "description": "Basename of the .feature file." },
    "scenarios": {
      "type": "object",
      "description": "Keyed by scenario name (plus [param=value, ...] for outline rows, #n for duplicates).",
      "additionalProperties": { "$ref": "#/$defs/scenario" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["keyword", "text", "hash", "source", "generatedBy", "actions"],
      "properties": {
        "keyword": { "type": "string" },
        "text": { "type": "string" },
        "hash": { "type": "string", "description": "Hash of step kind + normalized text + argument. A changed step text invalidates the step." },
        "source": { "enum": ["planned", "healed"] },
        "generatedBy": {
          "type": "object",
          "required": ["provider", "model"],
          "properties": { "provider": { "type": "string" }, "model": { "type": "string" } },
          "additionalProperties": false
        },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "required": ["by", "role", "name"],
          "properties": { "by": { "const": "role" }, "role": { "type": "string" }, "name": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["by", "value"],
          "properties": {
            "by": { "enum": ["testid", "label", "placeholder", "id", "text", "css"] },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "type": "object",
      "required": ["locators"],
      "properties": {
        "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locator" }, "description": "Ranked best-first." },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pattern": { "type": "string", "description": "JavaScript regex source. May contain ${env.X}/${param.x}/${vars.x} references." },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "target"],
          "properties": { "kind": { "enum": ["visible", "hidden", "enabled"] }, "target": { "$ref": "#/$defs/target" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "target", "min"],
          "properties": { "kind": { "const": "count" }, "target": { "$ref": "#/$defs/target" }, "min": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "target", "pattern"],
          "properties": {
            "kind": { "const": "text" },
            "target": { "$ref": "#/$defs/target" },
            "pattern": { "$ref": "#/$defs/pattern" },
            "flags": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "pattern"],
          "properties": { "kind": { "enum": ["url", "title"] }, "pattern": { "$ref": "#/$defs/pattern" }, "flags": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": { "type": { "const": "navigate" }, "url": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "target"],
          "properties": { "type": { "const": "click" }, "target": { "$ref": "#/$defs/target" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "target", "value"],
          "properties": { "type": { "enum": ["fill", "select"] }, "target": { "$ref": "#/$defs/target" }, "value": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "key"],
          "properties": { "type": { "const": "press" }, "key": { "type": "string" }, "target": { "$ref": "#/$defs/target" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "target", "checked"],
          "properties": { "type": { "const": "check" }, "target": { "$ref": "#/$defs/target" }, "checked": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "target", "file"],
          "properties": { "type": { "const": "upload" }, "target": { "$ref": "#/$defs/target" }, "file": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "target", "state"],
          "properties": {
            "type": { "const": "waitFor" },
            "target": { "$ref": "#/$defs/target" },
            "state": { "enum": ["visible", "hidden"] },
            "timeoutMs": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "check"],
          "properties": { "type": { "const": "assert" }, "check": { "$ref": "#/$defs/check" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "judge" } },
          "additionalProperties": false,
          "description": "Semantic assertion judged by the LLM on every run."
        }
      ]
    }
  }
}
