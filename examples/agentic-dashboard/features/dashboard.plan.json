                "target": {
                  "description": "kpi-open-tickets",
                  "locators": [
                    {
                      "by": "testid",
                      "value": "kpi-open-tickets"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "keyword": "And",
          "text": "I see customer satisfaction as a percentage",
          "hash": "1bc543ebbf662027",
          "source": "planned",
          "generatedBy": {
            "model": "offline-demo-brain",
            "provider": "scripted"
          },
          "actions": [
            {
              "type": "assert",
              "check": {
                "kind": "text",
