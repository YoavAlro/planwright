          ]
        },
        {
          "keyword": "Then",
          "text": "I see the open tickets KPI with a number",
          "hash": "c2ef493482c63e10",
          "source": "planned",
          "generatedBy": {
            "model": "offline-demo-brain",
            "provider": "scripted"
          },
          "actions": [
            {
              "type": "assert",
              "check": {
                "kind": "text",
