{
  "$schema": "https://raw.githubusercontent.com/YoavAlro/planwright/main/schema/plan.schema.json",
  "version": 1,
  "feature": "dashboard.feature",
  "scenarios": {
    "KPIs and recent tickets are visible": {
      "name": "KPIs and recent tickets are visible",
      "steps": [
        {
          "keyword": "Given",
          "text": "I am on the dashboard",
          "hash": "07ff4d2445733e09",
          "source": "planned",
          "generatedBy": {
            "model": "offline-demo-brain",
            "provider": "scripted"
          },
          "actions": [
            {
              "type": "navigate",
              "url": "/"
